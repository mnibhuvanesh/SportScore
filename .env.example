# ==============================================================================
# Centralized Sports Management & Performance Analytics Platform
# Environment Configuration Template
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Client Configuration & URLs
CLIENT_PORT=3000
CLIENT_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000/api/v1
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (MongoDB Standalone / Replica Set)
# For local dev: mongodb://127.0.0.1:27017/sports_platform
# For Docker Compose: mongodb://mongodb:27017/sports_platform
MONGODB_URI=mongodb://127.0.0.1:27017/sports_platform
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

# Redis Configuration (Sessions, Token Rotation, Rate Limiting & Pub/Sub)
# For local dev: redis://127.0.0.1:6379
# For Docker Compose: redis://redis:6379
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=sports:

# Authentication & Security
# Generate secure 64-character random secrets for production (e.g., openssl rand -hex 32)
# Generate unique values with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REMEMBER_ME_EXPIRES_IN=30d

# Cookie Configuration
COOKIE_SECRET=
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Password Security & Account Lockout
BCRYPT_SALT_ROUNDS=12
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Password Reset & Invitation Token Settings
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=30
INVITATION_TOKEN_EXPIRATION_DAYS=7

# Rate Limiting (Requests per window per IP/Account)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Logging & Monitoring
LOG_LEVEL=debug
LOG_FILE_PATH=logs/app.log

# Administrator Account Personalization
ADMIN_NAME="Platform Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Demo Data Seed Configuration
SEED_DEMO_DATA=true
DEMO_ADMIN_PASSWORD=
DEMO_ORGANIZER_PASSWORD=
DEMO_COACH_PASSWORD=
DEMO_ATHLETE_PASSWORD=
DEMO_SCORER_PASSWORD=
